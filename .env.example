# Discord self-bot configuration
# Get these from your Discord developer portal and by inspecting the Timeless RNG bot

# Your Discord account token (KEEP SECRET — do not commit or share!)
# To get: Open Discord, press F12, go to Network, refresh, filter "api", find Authorization header
DISCORD_TOKEN=your_token_here

# Channel ID where the bot commands will be sent (where Timeless RNG bot is active)
# To get: Enable Developer Mode in Discord, right-click channel → Copy Channel ID
CHANNEL_ID=1496625054950228168

# Timeless RNG bot user ID
# To get: Right-click Timeless RNG bot in Discord → Copy User ID
BOT_ID=1269716422620348532

# Guild ID (set to 0 for DM usage, or your server's Guild ID)
GUILD_ID=0
